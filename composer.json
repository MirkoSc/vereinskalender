{
    "name": "vereinskalender/vereinskalender",
    "description": "Web calendar for a football club: pitch occupancy and match schedule",
    "license": "GPL-3.0-or-later",
    "type": "project",
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "minishlink/web-push": "^10.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        },
        "files": [
            "app/src/View/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0",
            "ext-curl": "8.5.0",
            "ext-gd": "8.5.0",
            "ext-mbstring": "8.5.0",
            "ext-openssl": "8.5.0",
            "ext-pdo": "8.5.0",
            "ext-pdo_mysql": "8.5.0",
            "ext-zip": "8.5.0"
        }
    }
}
